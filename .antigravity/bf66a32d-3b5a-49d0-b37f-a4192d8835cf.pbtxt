  file_change {
    absolute_path_uri: "file:///src/components/InviteModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { getRoomInviteUrl, copyToClipboard } from \'../utils/invite\';\nimport {\n  Link2,\n  Copy,\n  Check,\n  Share2,\n  QrCode,\n  X,\n  Lock,\n  ShieldCheck,\n  Send,\n  MessageCircle,\n  ExternalLink,\n  Users,\n} from \'lucide-react\';\n\ninterface InviteModalProps {\n  isOpen: boolean;\n  roomCode: string;\n  onClose: () => void;\n}\n\nexport const InviteModal: React.FC<InviteModalProps> = ({\n  isOpen,\n  roomCode,\n  onClose,\n}) => {\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [copiedCode, setCopiedCode] = useState(false);\n  const [showQrCode, setShowQrCode] = useState(false);\n  const qrCanvasRef = useRef<HTMLCanvasElement>(null);\n\n  const inviteUrl = getRoomInviteUrl(roomCode);\n\n  // Simple clean QR code rendering on canvas\n  useEffect(() => {\n    if (!isOpen || !inviteUrl || !qrCanvasRef.current) return;\n    const canvas = qrCanvasRef.current;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    // Draw stylized anonymous QR mock pattern with encoded data representation\n    const size = 180;\n    canvas.width = size;\n    canvas.height = size;\n\n    ctx.fillStyle = \'#090b10\';\n    ctx.fillRect(0, 0, size, size);\n\n    // Seeded pseudo-random deterministic pattern based on roomCode\n    let hash = 0;\n    for (let i = 0; i < roomCode.length; i++) {\n      hash = (hash << 5) - hash + roomCode.charCodeAt(i);\n      hash |= 0;\n    }\n\n    const blockSize = 6;\n    const gridCount = Math.floor(size / blockSize);\n\n    ctx.fillStyle = \'#06b6d4\';\n\n    // Draw position finder markers in 3 corners\n    const drawFinder = (startX: number, startY: number) => {\n      ctx.fillStyle = \'#10b981\';\n      ctx.fillRect(startX, startY, 42, 42);\n      ctx.fillStyle = \'#090b10\';\n      ctx.fillRect(startX + 6, startY + 6, 30, 30);\n      ctx.fillStyle = \'#06b6d4\';\n      ctx.fillRect(startX + 12, startY + 12, 18, 18);\n    };\n\n    drawFinder(6, 6);\n    drawFinder(size - 48, 6);\n    drawFinder(6, size - 48);\n\n    // Draw inner grid\n    ctx.fillStyle = \'#06b6d4\';\n    let seed = Math.abs(hash) + 12345;\n    for (let r = 0; r < gridCount; r++) {\n      for (let c = 0; c < gridCount; c++) {\n        // Skip finder areas\n        if (\n          (r < 9 && c < 9) ||\n          (r < 9 && c > gridCount - 10) ||\n          (r > gridCount - 10 && c < 9)\n        ) {\n          continue;\n        }\n\n        seed = (seed * 9301 + 49297) % 233280;\n        if (seed / 233280 > 0.52) {\n          ctx.fillRect(c * blockSize + 2, r * blockSize + 2, blockSize - 2, blockSize - 2);\n        }\n      }\n    }\n\n    // Center icon badge\n    ctx.fillStyle = \'#090b10\';\n    ctx.beginPath();\n    ctx.arc(size / 2, size / 2, 18, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.strokeStyle = \'#10b981\';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n\n    ctx.fillStyle = \'#10b981\';\n    ctx.font = \'bold 10px monospace\';\n    ctx.textAlign = \'center\';\n    ctx.textBaseline = \'middle\';\n    ctx.fillText(\'ANON\', size / 2, size / 2);\n  }, [isOpen, inviteUrl, roomCode, showQrCode]);\n\n  if (!isOpen) return null;\n\n  const handleCopyLink = async () => {\n    const success = await copyToClipboard(inviteUrl);\n    if (success) {\n      setCopiedLink(true);\n      setTimeout(() => setCopiedLink(false), 2500);\n    }\n  };\n\n  const handleCopyCode = async () => {\n    const success = await copyToClipboard(roomCode);\n    if (success) {\n      setCopiedCode(true);\n      setTimeout(() => setCopiedCode(false), 2500);\n    }\n  };\n\n  const handleNativeShare = async () => {\n    if (navigator.share) {\n      try {\n        await navigator.share({\n          title: `Join Incognito Room #${roomCode}`,\n          text: `Join my private encrypted Incognito video/audio room (Room #${roomCode}). No account required!`,\n          url: inviteUrl,\n        });\n      } catch (err) {\n        // Ignored or cancelled\n      }\n    } else {\n      handleCopyLink();\n    }\n  };\n\n  const shareText = encodeURIComponent(\n    `Join my encrypted Incognito call (Room: ${roomCode}). Direct WebRTC, no accounts: ${inviteUrl}`\n  );\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-950/85 backdrop-blur-md p-4 animate-in fade-in duration-200\">\n      <div className=\"relative w-full max-w-lg rounded-2xl border border-slate-800 bg-[#090b10] shadow-2xl p-6 overflow-hidden\">\n        {/* Glowing border effects */}\n        <div className=\"absolute -top-24 -right-24 h-48 w-48 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none\" />\n        <div className=\"absolute -bottom-24 -left-24 h-48 w-48 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none\" />\n\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-4 border-b border-slate-800 mb-5 relative z-10\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-cyan-500/20 text-cyan-400 border border-cyan-500/30\">\n              <Share2 className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                <span>Invite to Private Room</span>\n                <span className=\"rounded bg-cyan-500/10 px-2 py-0.5 text-[10px] font-mono text-cyan-400 border border-cyan-500/20\">\n                  #{roomCode}\n                </span>\n              </h3>\n              <p className=\"text-[11px] text-slate-400\">Anyone with this unique link connects instantly to this room</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"rounded-xl border border-slate-800 bg-slate-900 p-2 text-slate-400 hover:bg-slate-800 hover:text-white transition-all cursor-pointer\"\n          >\n            <X className=\"h-4 w-4\" />\n          </button>\n        </div>\n\n        {/* Body Content */}\n        <div className=\"space-y-4 relative z-10\">\n          \n          {/* Shareable Invite Link Input Box */}\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1.5 flex items-center justify-between\">\n              <span className=\"flex items-center gap-1.5\">\n                <Link2 className=\"h-3.5 w-3.5 text-cyan-400\" />\n                <span>Instant Invite Link</span>\n              </span>\n              <span className=\"text-[10px] text-emerald-400 font-mono\">Instant 1-Click Join</span>\n            </label>\n\n            <div className=\"flex items-center gap-2 p-1.5 rounded-xl border border-slate-800 bg-slate-950\">\n              <input\n                id=\"shareable-invite-url-input\"\n                type=\"text\"\n                readOnly\n                value={inviteUrl}\n                className=\"flex-1 bg-transparent px-3 py-1.5 text-xs font-mono text-cyan-300 select-all focus:outline-none truncate\"\n              />\n              <button\n                id=\"copy-invite-link-btn\"\n                onClick={handleCopyLink}\n                className={`flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-xs font-bold transition-all cursor-pointer ${\n                  copiedLink\n                    ? \'bg-emerald-500 text-slate-950 shadow-[0_0_15px_rgba(16,185,129,0.4)]\'\n                    : \'bg-cyan-500 hover:bg-cyan-400 text-slate-950 shadow-[0_0_12px_rgba(6,182,212,0.3)]\'\n                }`}\n              >\n                {copiedLink ? <Check className=\"h-3.5 w-3.5\" /> : <Copy className=\"h-3.5 w-3.5\" />}\n                <span>{copiedLink ? \'Copied!\' : \'Copy Link\'}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Quick Room Code Pill Box */}\n          <div className=\"flex items-center justify-between p-3 rounded-xl border border-slate-800 bg-slate-900/60\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs text-slate-400\">Secret Room Code:</span>\n              <span className=\"text-sm font-mono font-bold text-white bg-slate-950 px-2.5 py-1 rounded-lg border border-slate-800\">\n                {roomCode}\n              </span>\n            </div>\n            <button\n              id=\"copy-room-code-btn\"\n              onClick={handleCopyCode}\n              className=\"flex items-center gap-1 text-xs text-slate-300 hover:text-cyan-400 transition-colors cursor-pointer px-2 py-1 rounded-lg hover:bg-slate-800\"\n            >\n              {copiedCode ? <Check className=\"h-3.5 w-3.5 text-emerald-400\" /> : <Copy className=\"h-3.5 w-3.5\" />}\n              <span>{copiedCode ? \'Code Copied\' : \'Copy Code\'}</span>\n            </button>\n          </div>\n\n          {/* Social Share & QR Quick Actions */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1\">\n            <button\n              onClick={handleNativeShare}\n              className=\"flex items-center justify-center gap-1.5 p-2.5 rounded-xl border border-slate-800 bg-slate-900/90 text-xs font-medium text-slate-200 hover:border-cyan-500/50 hover:bg-cyan-950/20 hover:text-cyan-300 transition-all cursor-pointer\"\n            >\n              <Share2 className=\"h-3.5 w-3.5\" />\n              <span>Share App</span>\n            </button>\n\n            <a\n              href={`https://api.whatsapp.com/send?text=${shareText}`}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"flex items-center justify-center gap-1.5 p-2.5 rounded-xl border border-slate-800 bg-slate-900/90 text-xs font-medium text-slate-200 hover:border-emerald-500/50 hover:bg-emerald-950/20 hover:text-emerald-300 transition-all cursor-pointer\"\n            >\n              <MessageCircle className=\"h-3.5 w-3.5\" />\n              <span>WhatsApp</span>\n            </a>\n\n            <a\n              href={`https://t.me/share/url?url=${encodeURIComponent(inviteUrl)}&text=${encodeURIComponent(`Join my Incognito Room #${roomCode}`)}`}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"flex items-center justify-center gap-1.5 p-2.5 rounded-xl border border-slate-800 bg-slate-900/90 text-xs font-medium text-slate-200 hover:border-blue-500/50 hover:bg-blue-950/20 hover:text-blue-300 transition-all cursor-pointer\"\n            >\n              <Send className=\"h-3.5 w-3.5\" />\n              <span>Telegram</span>\n            </a>\n\n            <button\n              onClick={() => setShowQrCode(!showQrCode)}\n              className={`flex items-center justify-center gap-1.5 p-2.5 rounded-xl border text-xs font-medium transition-all cursor-pointer ${\n                showQrCode\n                  ? \'border-cyan-500 bg-cyan-500/20 text-cyan-300\'\n                  : \'border-slate-800 bg-slate-900/90 text-slate-200 hover:border-slate-700\'\n              }`}\n            >\n              <QrCode className=\"h-3.5 w-3.5\" />\n              <span>QR Code</span>\n            </button>\n          </div>\n\n          {/* QR Code expansion section */}\n          {showQrCode && (\n            <div className=\"flex flex-col items-center justify-center p-4 rounded-xl border border-slate-800 bg-slate-950/80 animate-in fade-in zoom-in-95 duration-150\">\n              <p className=\"text-xs text-slate-400 mb-3\">Scan with phone camera to join room directly</p>\n              <div className=\"p-3 rounded-2xl bg-[#090b10] border border-slate-800 shadow-xl\">\n                <canvas ref={qrCanvasRef} className=\"rounded-lg\" />\n              </div>\n            </div>\n          )}\n\n          {/* Privacy & WebRTC info note */}\n          <div className=\"rounded-xl border border-slate-800/70 bg-slate-950/50 p-3.5 flex items-start gap-2.5 text-[11px] text-slate-400\">\n            <Lock className=\"h-4 w-4 text-emerald-400 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"font-semibold text-slate-300\">Direct WebRTC P2P:</span> When a peer opens this invite link, your browsers connect directly with encrypted audio, video, screen share, and ephemeral whiteboard.\n            </div>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-end\">\n          <button\n            onClick={onClose}\n            className=\"rounded-xl bg-slate-800 hover:bg-slate-700 px-5 py-2 text-xs font-bold text-white transition-colors cursor-pointer\"\n          >\n            Done\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
